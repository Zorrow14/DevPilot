PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
DATABASE_URL="postgresql://username:password@host:port/database"
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Google Gemini (AI roadmap generation). Free tier keys: https://aistudio.google.com/apikey
# Roadmap generation returns 503 with a clear message when this is unset;
# every other route works without it.
GEMINI_API_KEY=
# Optional override, defaults to gemini-3.6-flash.
GEMINI_MODEL=

# Comma-separated addresses that are granted ADMIN on sign-in.
# Firebase creates the account, so there is no Postgres row for a seed script to
# promote and no way into the admin screens without this — set it to your own
# address before the first deploy, then manage roles in the admin UI.
# Promote-only: removing an address here does not demote that account.
ADMIN_EMAILS=
